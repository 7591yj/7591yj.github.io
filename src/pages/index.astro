---
import { getCollection } from "astro:content";
import "../styles/pages/home.css";
import Layout from "../layouts/Layout.astro";
import HeroCarousel from "../components/carousel/HeroCarousel.tsx";
import HomeBlogSection from "../components/home/HomeBlogSection.astro";
import HomeAboutDossier from "../components/home/HomeAboutDossier.astro";
import { useTranslations } from "../i18n/ui";

const posts = (await getCollection("blog")).map((entry) => ({
  frontmatter: entry.data,
  url: `/blog/${entry.id}`,
}));
const latestPosts = posts
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date ?? 0).getTime() -
      new Date(a.frontmatter.date ?? 0).getTime(),
  )
  .slice(0, 3);

const softwareProjects = (await getCollection("projects"))
  .map((entry) => ({
    frontmatter: entry.data,
    slug: entry.id,
  }))
  .filter((p) => p.frontmatter.category === "software");

function projectHasImages(project: {
  frontmatter: { images?: string[] };
}): boolean {
  return !!project.frontmatter.images && project.frontmatter.images.length > 0;
}

const sortedProjects = [...softwareProjects].sort(
  (a, b) => Number(!projectHasImages(a)) - Number(!projectHasImages(b)),
);

const slides = sortedProjects.map((p) => ({
  image: p.frontmatter.images?.[0],
  project: {
    title: p.frontmatter.title,
    subtitle: p.frontmatter.subtitle,
    tech: p.frontmatter.tech,
    status: p.frontmatter.status,
    current: p.frontmatter.current,
    href: `/projects/${p.slug}`,
  },
}));

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}.${m}.${day}`;
}

const now = Date.now();
const thirtyDays = 30 * 24 * 60 * 60 * 1000;
const latestDate =
  latestPosts.length > 0
    ? formatDate(latestPosts[0].frontmatter.date)
    : "----.--.--";

const featuredPost = latestPosts[0];
const archivePosts = latestPosts.slice(1);

const focus = ["Homelab operations", "Tactile UI", "Reproducible setups"];
const stack = ["TypeScript", "Python", "Nix", "React", "Svelte", "Containers"];

const locale = Astro.currentLocale ?? "en";
const t = useTranslations(locale);
---

<Layout
  transparentHeader
  description="Portfolio and blog of 7591yj - software development, design, and research."
>
  <main>
    <section class="hero-section">
      <HeroCarousel
        slides={slides}
        fullscreen
        releasedLabel={t("status.released")}
        inDevelopmentLabel={t("status.inDevelopment")}
        client:idle
      />
    </section>

    <HomeBlogSection
      title="ARTICLES///"
      latestDate={latestDate}
      count={latestPosts.length}
      featuredPost={featuredPost}
      archivePosts={archivePosts}
      now={now}
      thirtyDays={thirtyDays}
      allHref="/blog"
      allLabel="View all dispatches →"
    />

    <HomeAboutDossier
      title="ABOUT///"
      focus={focus}
      stack={stack}
      aboutHref="/about"
      aboutLabel="View full dossier →"
    >
      I build calm, working systems that make infrastructure
      <span class="statement-keyword">visible</span>, interfaces
      <span class="statement-keyword">tactile</span>, and state
      <span class="statement-keyword">predictable</span>.
    </HomeAboutDossier>
  </main>
</Layout>
