---
import "../styles/pages/projects.css";
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/ui/PageHeading.astro";
import ProjectGraph from "../components/graph/ProjectGraph";
import { SITE_NAME } from "../consts";
import type { Project } from "../types";
import { useTranslations } from "../i18n/ui";
import { getProjects } from "../lib/content";

const t = useTranslations(Astro.currentLocale);

const allProjects: Project[] = (await getProjects("en")).map(
  ({ slug, data }) => ({
    title: data.title,
    subtitle: data.subtitle,
    status: data.status,
    desc: data.desc,
    tech: data.tech,
    tags: data.tags,
    images: data.images,
    current: data.current,
    category: data.category,
    slug,
    href: data.link,
  }),
);
---

<Layout
  title={`${SITE_NAME} | Projects`}
  description="Software projects and experiments by 7591yj."
>
  <main>
    <section>
      <PageHeading module="MODULE.001///" title="Projects" />
    </section>

    <section class="schematic">
      <ProjectGraph
        projects={allProjects}
        selectTechLabel={t("projects.selectTech")}
        techSelectedTemplate={t("projects.techSelected")}
        clearLabel={t("projects.clear")}
        client:visible
      />
    </section>
  </main>
</Layout>
