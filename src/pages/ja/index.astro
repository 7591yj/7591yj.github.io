---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import "../../styles/pages/home.css";
import Layout from "../../layouts/Layout.astro";
import HeroCarousel from "../../components/carousel/HeroCarousel.tsx";
import HomeBlogSection from "../../components/home/HomeBlogSection.astro";
import HomeAboutDossier from "../../components/home/HomeAboutDossier.astro";
import { useTranslations } from "../../i18n/ui";

const posts = (await getCollection("blogJa")).map((entry) => ({
  frontmatter: entry.data,
  url: `/ja/blog/${entry.id}`,
}));
const latestPosts = posts
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date ?? 0).getTime() -
      new Date(a.frontmatter.date ?? 0).getTime(),
  )
  .slice(0, 3);

const softwareProjects = (await getCollection("projectsJa"))
  .map((entry) => ({
    frontmatter: entry.data,
    slug: entry.id,
  }))
  .filter((p) => p.frontmatter.category === "software");

function projectHasImages(project: {
  frontmatter: { images?: string[] };
}): boolean {
  return !!project.frontmatter.images && project.frontmatter.images.length > 0;
}

const sortedProjects = [...softwareProjects].sort(
  (a, b) => Number(!projectHasImages(a)) - Number(!projectHasImages(b)),
);

const slides = sortedProjects.map((p) => ({
  image: p.frontmatter.images?.[0],
  project: {
    title: p.frontmatter.title,
    subtitle: p.frontmatter.subtitle,
    tech: p.frontmatter.tech,
    status: p.frontmatter.status,
    current: p.frontmatter.current,
    href: getRelativeLocaleUrl("ja", `/projects/${p.slug}`),
  },
}));

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}.${m}.${day}`;
}

const now = Date.now();
const thirtyDays = 30 * 24 * 60 * 60 * 1000;
const latestDate =
  latestPosts.length > 0
    ? formatDate(latestPosts[0].frontmatter.date)
    : "----.--.--";

const featuredPost = latestPosts[0];
const archivePosts = latestPosts.slice(1);

const focus = ["ホームラボ運用", "触感のあるUI", "再現可能な環境"];
const stack = ["TypeScript", "Python", "Nix", "React", "Svelte", "コンテナ"];

const t = useTranslations(Astro.currentLocale);
---

<Layout
  transparentHeader
  description="7591yjのポートフォリオとブログ - ソフトウェア開発、デザイン、リサーチ"
>
  <main>
    <section class="hero-section">
      <HeroCarousel
        slides={slides}
        fullscreen
        releasedLabel={t("status.released")}
        inDevelopmentLabel={t("status.inDevelopment")}
        client:idle
      />
    </section>

    <HomeBlogSection
      title="記事///"
      latestDate={latestDate}
      count={latestPosts.length}
      featuredPost={featuredPost}
      archivePosts={archivePosts}
      now={now}
      thirtyDays={thirtyDays}
      allHref={getRelativeLocaleUrl("ja", "/blog")}
      allLabel="View all dispatches →"
    />

    <HomeAboutDossier
      title="プロフィール///"
      focus={focus}
      stack={stack}
      aboutHref={getRelativeLocaleUrl("ja", "/about")}
      aboutLabel="View full dossier →"
    >
      インフラを<span class="statement-keyword">見える</span>ものに、<br />
      インターフェースを<span class="statement-keyword">触れられる</span
      >ものに、<br />
      状態を<span class="statement-keyword">予測できる</span>ものにする、<br />
      静かな実働システムをつくっています。
    </HomeAboutDossier>
  </main>
</Layout>
