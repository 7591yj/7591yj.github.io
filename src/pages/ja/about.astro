---
import "../../styles/pages/about.css";
import Layout from "../../layouts/Layout.astro";
import PageHeading from "../../components/ui/PageHeading.astro";
import AboutMeta from "../../components/about/AboutMeta.astro";
import AboutEducation from "../../components/about/AboutEducation.astro";
import AboutTableSection from "../../components/about/AboutTableSection.astro";
import AboutPapers from "../../components/about/AboutPapers.astro";
import { SITE_NAME, EMAIL } from "../../consts";
import type { AboutTableCell, AboutTableRow } from "../../types/aboutTable";

const metaFields = [
  { icon: "me", label: "氏名", value: "金 栄鎮 (KIM YEONGJIN)" },
  { icon: "cake", label: "生年月日", value: "2002. 07. 20" },
  { icon: "at", label: "メール", value: EMAIL, href: `mailto:${EMAIL}` },
  {
    icon: "map-pin-house",
    label: "出身地",
    value: "全州市、韓国",
    href: "https://www.google.com/maps/search/?api=1&query=Jeonju,%20South%20Korea",
  },
  {
    icon: "map-pin",
    label: "現在地",
    value: "東京都、日本",
    href: "https://www.google.com/maps/search/?api=1&query=Tokyo,%20Japan",
  },
];

const educationCards = [
  {
    href: "https://www.inha.ac.kr/sites/kr/index..do",
    src: "https://raw.githubusercontent.com/incalc/inha-logo/refs/heads/master/svg/static/inha_symbol_mark.svg",
    institution: "仁荷大学校",
    location: "仁川市、韓国",
    position: "学生",
    period: "2021. 03 - 2027. 02 (予定)",
    major: "情報通信工学科",
    majorLabel: "専攻",
    majorLabelAfter: true,
    class: "p-5",
    size: "20%",
  },
  {
    href: "https://www.chuo-u.ac.jp/",
    src: "https://www.chuo-u.ac.jp/media/images/en/common/header_logo.svg",
    institution: "中央大学",
    location: "東京都、日本",
    position: "交換留学生",
    period: "2025. 09 - 2026. 08 (予定)",
    major: "情報工学科",
    majorLabel: "専攻",
    majorLabelAfter: true,
    class: "p-5",
    size: "70%",
  },
];

const certHeaders = ["取得日", "資格名", "発行機関"];
const certRows = [
  ["2021. 07. 13", "普通自動車第一種運転免許", "全羅北道地方警察庁"],
  ["2024. 08. 13", "日本語能力試験 N2", "国際交流基金"],
  ["2025. 01. 26", "TOEIC、925点", "韓国TOEICコミッティ"],
  ["2025. 05. 24", "TOPCIT、677点", "科学技術情報通信部（韓国）"],
];

const papers = [
  {
    href: "https://www.researchgate.net/publication/400239914_Automated_Korean-English_Bilingual_Highlighted_Text_Extraction_Using_HSV_Segmentation",
    body: `第25回国際エレクトロニクス・情報・通信会議（ICEIC 2026）- 中国・マカオ 2026（発表済）"Automated Korean-English Bilingual Highlighted Text Extraction Using HSV Segmentation" SeungJun Lee, Yeongjin Kim et.al 8`,
  },
  {
    href: "#",
    disabled: true,
    body: `第13回 IEEE 国際消費者エレクトロニクス会議 – 台湾・桃園 2026（IEEE ICCE-TW 2026）（受理済） "Illumination-Adaptive Part Detection for Automated FDM 3D Printing Dataset Collection" Seungyun Choi, Seungjun Lee, Yeongjin Kim, Namjoon Kim, Hyukjae Lee`,
  },
];

const clubHeaders = ["期間", "名称", "内容", "役職"];
const igrusLink = {
  type: "link",
  label: "IGRUS",
  href: "https://www.instagram.com/igrus_inha/",
} satisfies AboutTableCell;
const seedsLink = {
  type: "link",
  label: "Seeds",
  href: "https://jelly-locust-cea.notion.site/Seeds-1beac07ca4e98043bbe9e81ccf29e806",
} satisfies AboutTableCell;
const clubRows = [
  ["2021. 03 - 2021. 08", igrusLink, "ソフトウェア開発", "メンバー"],
  ["2024. 03 - 2024. 08", igrusLink, "ソフトウェア開発", "メンバー"],
  ["2024. 03 - 2025. 08", seedsLink, "ウェブ開発", "スタッフ"],
] satisfies AboutTableRow[];

const awardHeaders = ["日付", "名称", "受賞"];
const awardRows = [
  [
    "2023. 11. 12",
    {
      type: "lines",
      lines: ["中央大学（韓国） × SEOULLAB PARTNERS '2023", "START-LAB"],
    },
    "最優秀賞",
  ],
  [
    "2025. 01. 18",
    " 2025 GreenTech グローバルソン ",
    "最優秀スタートアップピッチ賞",
  ],
  [
    "2025. 11. 19",
    {
      type: "lines",
      lines: [
        "2025 ハニウム ドリームアップ コンテスト",
        "（創造的チャレンジ部門）",
      ],
    },
    {
      type: "lines",
      lines: ["奨励賞（本審査）", "（予選にて優秀プロジェクトに選出）"],
    },
  ],
  [
    "2025. 11. 12",
    {
      type: "link",
      label: "画像・映像コンテンツ演習 成果発表会",
      href: "https://www.chuo-u.ac.jp/academics/faculties/advanced/departments/infotech/news/2026/01/83597/",
    },
    "最優秀賞",
  ],
] satisfies AboutTableRow[];
---

<Layout title={`${SITE_NAME} | プロフィール`} description="7591yjについて">
  <main>
    <section>
      <PageHeading module="MODULE.003///" title="プロフィール">
        <AboutMeta fields={metaFields} />
      </PageHeading>

      <AboutEducation title="学歴///" cards={educationCards} />

      <AboutTableSection
        title="資格・検定///"
        tableClass="info-table w-full"
        headers={certHeaders}
        rows={certRows}
        headerClass="font-shippori text-xl"
      />

      <AboutPapers title="論文///" papers={papers} />

      <AboutTableSection
        title="部活・サークル///"
        tableClass="info-table w-full"
        headers={clubHeaders}
        rows={clubRows}
        headerClass="font-shippori text-xl flex-1"
        firstRowClass="flex-1"
      />

      <AboutTableSection
        title="受賞歴///"
        tableClass="info-table award-table w-full"
        headers={awardHeaders}
        rows={awardRows}
        colgroup={["", "50%", "50%"]}
        headerClass="font-shippori text-xl"
      />
    </section>
  </main>
</Layout>
