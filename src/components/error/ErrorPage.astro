---
import { getRelativeLocaleUrl } from "astro:i18n";
import Shell from "../../layouts/Shell.astro";
import { detectLocale, useTranslations } from "../../i18n/ui";
import { SITE_NAME } from "../../consts";

interface Props {
  code: 404 | 500;
}

const { code } = Astro.props;
const locale = detectLocale(Astro.url.pathname);
const t = useTranslations(locale);
---

<Shell title={`${SITE_NAME} | ${code}`} alternates={null} noindex>
  <main class="error">
    <header class="page-head">
      <p class="kicker" data-reveal>
        <span>{t("error.kicker")}</span>
      </p>
      <h1 class="display error__code" data-error-code>{code}</h1>
    </header>
    <div class="error__details" data-reveal>
      <p class="error__message">{t(`${code}.message` as const)}</p>
    </div>
    <footer class="error__foot" data-reveal>
      <a href={getRelativeLocaleUrl(locale, "/")}>← {t("shell.backWork")}</a>
    </footer>
  </main>
</Shell>

<script>
  import "./error.client";
</script>

<style>
  .error {
    min-height: 100svh;
    padding-bottom: 9rem;
  }

  .error__code {
    font-size: clamp(6rem, 16vw, 12rem);
    line-height: 0.85;
    font-variant-numeric: tabular-nums;
  }

  .error__code--reels {
    display: flex;
    width: fit-content;
    white-space: nowrap;
  }

  /* error.client.ts builds the digit reels at runtime. */
  :global(.error__digit) {
    height: 1.3em;
    margin-block: -0.225em;
    clip-path: inset(0 -50%);
    text-align: center;
  }

  :global(.error__strip),
  :global(.error__strip > span) {
    display: block;
  }

  :global(.error__strip > span) {
    height: 1.3em;
    line-height: 1.3em;
  }

  .error__details {
    margin-inline: var(--gutter);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .error__message {
    font: 400 clamp(1.5rem, 3vw, 2.25rem) / 1.2 var(--font-display);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .error__foot {
    padding: var(--foot-gap) var(--gutter) 0;
    font: 600 clamp(1.5rem, 3vw, 2.5rem) / 1 var(--font-display);
    letter-spacing: -0.03em;
  }

  :global(html[data-shell]) .error__foot a:hover,
  .error__foot a:focus-visible {
    color: var(--color-accent);
  }
</style>
