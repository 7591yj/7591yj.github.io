---
import BlogPostCard from "../blog/BlogPostCard.astro";
import type { PostLike } from "./blogTypes";

interface Props {
  post: PostLike;
  now: number;
  thirtyDays: number;
  index: number;
  delay: number;
}

const { post, now, thirtyDays, index, delay } = Astro.props;
---

<BlogPostCard
  url={post.url!}
  title={post.frontmatter.title}
  date={post.frontmatter.date}
  description={post.frontmatter.description}
  tags={post.frontmatter.tags}
  isNew={now - new Date(post.frontmatter.date).getTime() < thirtyDays}
  index={index}
  delay={delay}
/>
