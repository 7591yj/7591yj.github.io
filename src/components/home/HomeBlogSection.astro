---
import SectionBlock from "../ui/SectionBlock.astro";
import BlogFeed from "./BlogFeed.astro";
import type { PostLike } from "./blogTypes";

interface Props {
  title: string;
  latestDate: string;
  count: number;
  featuredPost: PostLike | undefined;
  archivePosts: PostLike[];
  now: number;
  thirtyDays: number;
  allHref: string;
  allLabel: string;
}

const {
  title,
  latestDate,
  count,
  featuredPost,
  archivePosts,
  now,
  thirtyDays,
  allHref,
  allLabel,
} = Astro.props;
---

<!-- ============ BLOG ============ -->
<section class="preview-section">
  <SectionBlock title={title}>
    <div class="section-bar" aria-hidden="true">
      <div class="section-bar__info">
        <span class="section-bar__accent">WRITING.FEED</span>
        <span class="section-bar__sep">//</span>
        <span>LATEST {latestDate}</span>
        <span class="section-bar__sep">//</span>
        <span>{count} ARTICLES</span>
      </div>
    </div>

    <BlogFeed
      featuredPost={featuredPost}
      archivePosts={archivePosts}
      now={now}
      thirtyDays={thirtyDays}
    />

    <div class="section-link-row" data-animate>
      <a class="section-text-link" href={allHref}>{allLabel}</a>
    </div>
  </SectionBlock>
</section>
