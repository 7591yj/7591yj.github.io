---
import SectionBlock from "../ui/SectionBlock.astro";

interface Props {
  title: string;
  focus: string[];
  stack: string[];
  aboutHref: string;
  aboutLabel: string;
}

const { title, focus, stack, aboutHref, aboutLabel } = Astro.props;
---

<!-- ============ ABOUT ============ -->
<section class="preview-section">
  <SectionBlock title={title}>
    <div class="section-bar" aria-hidden="true">
      <div class="section-bar__info">
        <span class="section-bar__accent">DOSSIER</span>
        <span class="section-bar__sep">//</span>
        <span>CURRENT</span>
      </div>
    </div>

    <div class="about-dossier" data-animate>
      <div class="about-dossier__statement">
        <p><slot /></p>
      </div>

      <dl class="about-dossier__facts">
        <div>
          <dt>Focus</dt>
          <dd>
            <ul>
              {focus.map((item) => <li>{item}</li>)}
            </ul>
          </dd>
        </div>
        <div>
          <dt>Stack</dt>
          <dd>
            <ul>
              {stack.map((item) => <li>{item}</li>)}
            </ul>
          </dd>
        </div>
      </dl>

      <a class="about-dossier__link" href={aboutHref}>{aboutLabel}</a>
    </div>
  </SectionBlock>
</section>
