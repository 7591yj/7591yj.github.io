---
import Shell from "../../layouts/Shell.astro";
import { render } from "astro:content";
import { getBlogPosts } from "../../lib/content";
import { formatDate } from "../../lib/date";
import { readingMinutes, outline } from "../../lib/reading";
import { useTranslations, type Locale } from "../../i18n/ui";
import { SITE_NAME } from "../../consts";
import "../ui/interactive-list.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = await getBlogPosts(locale);
const pad = (n: number) => String(n).padStart(2, "0");
const previews = await Promise.all(
  posts.map(async (post) => ({
    id: `post-${post.slug}`,
    minutes: t("writing.minutes", { count: String(readingMinutes(post)) }),
    sections: outline((await render(post.source)).headings),
  })),
);
---

<Shell active="writing" title={`${SITE_NAME} | ${t("writing.title")}`}>
  <main class="writing">
    <header class="writing-head page-head">
      <h1 class="kicker" data-reveal>
        <span>{t("writing.title")}</span>
      </h1>
    </header>

    <ol class="writing-list interactive-list" data-writing-list>
      {
        posts.map((post, i) => (
          <li data-reveal>
            <a
              class="interactive-row"
              href={post.url}
              data-plate={`post-${post.slug}`}
            >
              <span class="w-no">{pad(posts.length - i)}</span>
              <span class="w-date">
                <span>{formatDate(post.data.date)}</span>
                <span>{previews[i].minutes}</span>
              </span>
              <span class="w-main">
                <span class="w-title interactive-title">{post.data.title}</span>
                {post.data.description && (
                  <span class="w-desc">{post.data.description}</span>
                )}
              </span>
              <span class="w-tags">
                {(post.data.tags ?? []).map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </span>
              <span class="w-arrow interactive-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    {
      previews.map((preview) => (
        <template data-plate-tpl={preview.id}>
          <p class="w-outline__head">
            <span>{t("writing.contents")}</span>
            <span>{preview.minutes}</span>
          </p>
          <ol class="w-outline">
            {preview.sections.map((section, i) => (
              <li>
                <span>{pad(i + 1)}</span>
                <span>{section}</span>
              </li>
            ))}
          </ol>
        </template>
      ))
    }
    <div class="writing-preview" data-writing-preview aria-hidden="true"></div>
  </main>
</Shell>

<script>
  import "../../scripts/writing.ts";
</script>

<style>
  .writing {
    padding-bottom: 9rem;
  }

  .writing-head {
    padding-bottom: 1.75rem;
  }

  .writing-list {
    border-top: 1px solid var(--color-text-primary);
    margin-inline: var(--gutter);
  }

  .writing-list a {
    display: grid;
    grid-template-columns: 3rem 7rem minmax(0, 1fr) auto 2rem;
    align-items: baseline;
    gap: var(--spacing-lg);
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .w-no,
  .w-date {
    font: var(--label);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .w-date {
    display: grid;
    gap: 0.25rem;
  }

  .w-main {
    display: grid;
    gap: 0.6rem;
  }

  .w-title {
    justify-self: start;
    font: 600 clamp(1.75rem, 3.6vw, 3.25rem) / 1.02 var(--font-display);
    letter-spacing: -0.04em;
  }

  .w-desc {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
  }

  .w-tags {
    display: flex;
    gap: 0.3rem;
  }

  .w-arrow {
    justify-self: end;
    font: 500 1.5rem / 1 var(--font-display);
  }

  .writing-preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: var(--z-overlay);
    display: grid;
    gap: 1rem;
    width: 17rem;
    margin: -2rem 0 0 2.5rem;
    padding: 1.1rem 1.25rem 1.25rem;
    border-radius: 0.5rem;
    background: var(--color-bg-secondary);
    box-shadow: var(--shadow-popover);
    pointer-events: none;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity var(--duration-normal) var(--ease-out-quart),
      scale 600ms var(--ease-out-expo);
  }

  .writing-preview.is-visible {
    opacity: 1;
    scale: 1;
  }

  @media (max-width: 719px) {
    .writing-list a {
      grid-template-columns: 1fr auto;
      gap: 0.6rem 1rem;
      padding: 1.5rem 0;
    }

    .w-no,
    .w-tags {
      display: none;
    }

    .w-date {
      grid-column: 1 / -1;
      display: flex;
      gap: 0.75rem;
    }

    .w-main {
      grid-column: 1;
      gap: 0.4rem;
    }

    .w-title {
      font-size: 1.625rem;
      line-height: 1.08;
    }

    .w-desc {
      font-size: var(--font-size-base);
    }

    .w-arrow {
      align-self: start;
      font-size: 1.25rem;
      line-height: 1.4;
    }
  }

  .w-outline__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    font: var(--label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .w-outline__head > :first-child {
    color: var(--color-accent);
  }

  .w-outline {
    display: grid;
    gap: 0.55rem;
  }

  .w-outline li {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    align-items: baseline;
    font-size: var(--font-size-sm);
    line-height: 1.3;
  }

  .w-outline li > :first-child {
    font: var(--label);
    color: var(--color-text-muted);
  }
</style>
