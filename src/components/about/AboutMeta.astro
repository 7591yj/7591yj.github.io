---
import { Icon } from "astro-icon/components";

interface Field {
  icon: string;
  label: string;
  value: string;
  href?: string;
}

interface Props {
  fields: Field[];
}

const { fields } = Astro.props;
---

<div class="meta">
  {
    fields.map((f) => (
      <Fragment>
        <span class="meta__label">
          <Icon name={f.icon} /> {f.label}
        </span>
        {f.href ? (
          <a class="meta__link" href={f.href}>
            {f.value} &#8599;
          </a>
        ) : (
          <span class="meta__value">{f.value}</span>
        )}
      </Fragment>
    ))
  }
</div>
