---
import type { AboutTableRow } from "../../types/aboutTable";
import SectionBlock from "../ui/SectionBlock.astro";
import ColGroup from "./ColGroup.astro";
import TableHeader from "./TableHeader.astro";
import TableRows from "./TableRows.astro";

interface Props {
  title: string;
  tableClass: string;
  headers: string[];
  rows: AboutTableRow[];
  colgroup?: string[];
  headerClass?: string;
  firstRowClass?: string;
}

const {
  title,
  tableClass,
  headers,
  rows,
  colgroup,
  headerClass,
  firstRowClass,
} = Astro.props;
---

<SectionBlock title={title}>
  <div class="container-main pt-6 pb-6 overflow-x-auto">
    <table class={tableClass}>
      <ColGroup colgroup={colgroup} />
      <TableHeader headers={headers} headerClass={headerClass} />
      <TableRows rows={rows} firstRowClass={firstRowClass} />
    </table>
  </div>
</SectionBlock>
