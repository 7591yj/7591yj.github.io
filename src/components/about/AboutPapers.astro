---
import SectionBlock from "../ui/SectionBlock.astro";
import PaperCard from "../ui/PaperCard.astro";

interface Paper {
  href: string;
  disabled?: boolean;
  body: string;
}

interface Props {
  title: string;
  papers: Paper[];
}

const { title, papers } = Astro.props;
---

<SectionBlock title={title}>
  <div class="container-main pt-6 pb-6">
    {
      papers.map((p) => (
        <PaperCard href={p.href} disabled={p.disabled}>
          {p.body}
        </PaperCard>
      ))
    }
  </div>
</SectionBlock>
