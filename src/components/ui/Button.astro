---
import { Icon } from "astro-icon/components";
import "./Button.css";

interface Props {
  variant?: "default" | "reverse" | "icon";
  size?: "sm" | "md" | "lg";
  icon?: string;
  href?: string;
  class?: string;
  disabled?: boolean;
  [key: string]: unknown;
}

const {
  variant = "default",
  size = "md",
  icon,
  href,
  class: className,
  disabled,
  ...rest
} = Astro.props;
const Tag = href ? "a" : "button";
const hasLabel = Astro.slots.has("default");
const ariaDisabled = disabled ? "true" : undefined;
---

<Tag
  class:list={["btn", `btn--${variant}`, `btn--${size}`, className]}
  href={href}
  aria-disabled={ariaDisabled}
  data-haptic="nudge"
  {...rest}
>
  {variant !== "icon" && <span class="btn__fill" aria-hidden="true" />}
  {icon && <Icon name={icon} class="btn__icon" />}
  {
    hasLabel && (
      <span class="btn__label">
        <slot />
      </span>
    )
  }
</Tag>

<script>
  import "./Button.client.ts";
</script>
