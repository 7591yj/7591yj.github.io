---
interface Props {
  src: string;
  alt?: string;
  imgSize?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  src,
  alt = "",
  imgSize = "100%",
  class: className,
  ...rest
} = Astro.props;
---

<div class:list={["media-frame", className]} style={`--img-size: ${imgSize}`}>
  <img src={src} alt={alt} loading="lazy" decoding="async" {...rest} />
</div>

<style>
  .media-frame {
    display: grid;
    place-items: center;
    height: 100%;
    overflow: hidden;
    border-radius: 0.375rem;
    background: var(--color-bg-secondary);
    line-height: 0;
  }

  .media-frame img {
    display: block;
    width: var(--img-size);
    height: var(--img-size);
    object-fit: scale-down;
    transition: scale 900ms var(--ease-out-expo);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .media-frame:hover img {
      scale: 1.03;
    }
  }
</style>
