---
import { Icon } from "astro-icon/components";

interface Props {
  institution: string;
  location: string;
  position: string;
  period: string;
  major: string;
  majorLabel: string;
  majorLabelAfter: boolean;
}

const {
  institution,
  location,
  position,
  period,
  major,
  majorLabel,
  majorLabelAfter,
} = Astro.props;
---

<div class="edu-card__content">
  <h3 class="font-shippori text-2xl pt-2 pb-2 flex items-center gap-2">
    <Icon name="cutoff-square" class="inline text-[var(--color-accent)]" />
    <span>{institution}</span>
  </h3>
  <ul class="text-l">
    <li>
      <Icon name="map-pin" />
      <span>{location}</span>
    </li>
    <li>
      <Icon name="me" />
      <span>{position}</span>
    </li>
    <li>
      <Icon name="calendar" />
      <span>{period}</span>
    </li>
  </ul>
  <p>
    {majorLabelAfter ? `${major} ${majorLabel}` : `${majorLabel} ${major}`}
  </p>
</div>
