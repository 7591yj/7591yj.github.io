---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<span class="slogan-seg" aria-hidden="true">
  {
    [0, 1, 2, 3].map(() => (
      <>
        <span>{text}</span>
        <span class="slogan-dot">·</span>
      </>
    ))
  }
</span>

<style>
  .slogan-seg {
    display: flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    font-weight: 600;
    color: var(--color-text-primary);
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .slogan-dot {
    margin: 0 1rem;
    color: var(--color-accent);
  }
</style>
