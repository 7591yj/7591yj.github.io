<div class="nixos-logo-wrap">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="-2150 -1996 9124 3992"
    role="img"
    aria-label="NixOS logo"
  >
    <Defs />
    {
      arms.map((arm) => (
        <polygon
          class="nixos-arm"
          data-stroke={arm.stroke}
          fill={arm.fill}
          points={armPoints}
          transform={arm.transform}
        />
      ))
    }
    <g transform="translate(1152.0 665.1075101064489)">
      {letters.map((d) => <path class="nixos-letter" fill="black" d={d} />)}
    </g>
  </svg>
</div>
<script>
  import "./NixOSLogo.client.ts";
</script>
