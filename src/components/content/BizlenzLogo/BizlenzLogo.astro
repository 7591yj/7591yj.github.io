---
import "./BizlenzLogo.css";

// Bar order controls the draw sequence.
const bars = [
  [221, 433],
  [408, 333],
  [595, 233],
  [782, 133],
];
const swoosh =
  "M98.1115 797.457C-20.0554 823.745 121.607 729.547 207.209 679.163C311.069 609.428 589.276 447.175 871.225 356.044C1153.17 264.914 1061.44 342.901 980.323 393.285C735.488 517.056 216.278 771.169 98.1115 797.457Z";
---

<div class="bizlenz-logo-wrap">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1116 1116"
    fill="none"
    role="img"
    aria-label="Bizlenz logo"
  >
    {
      bars.map(([x, y]) => (
        <rect
          class="bizlenz-bar"
          x={x}
          y={y}
          width="150"
          height="550"
          rx="10"
          fill="currentColor"
        />
      ))
    }
    <path
      class="bizlenz-swoosh"
      d={swoosh}
      fill="none"
      stroke="currentColor"
      stroke-width="30"></path>
  </svg>
</div>
<script>
  import "./BizlenzLogo.client.ts";
</script>
