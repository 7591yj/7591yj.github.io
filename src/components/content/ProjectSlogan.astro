---
import Segment from "./Segment.astro";

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div class="slogan-strip" aria-label={text}>
  <div class="slogan-track">
    {[0, 1].map(() => <Segment text={text} />)}
  </div>
</div>

<style>
  .slogan-strip {
    overflow: hidden;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    padding: 0.65rem 0;
  }

  .slogan-track {
    display: flex;
    width: max-content;
    animation: slogan-scroll 55s linear infinite;
  }

  .slogan-track:hover {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .slogan-track {
      animation: none;
    }
  }

  @keyframes slogan-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
