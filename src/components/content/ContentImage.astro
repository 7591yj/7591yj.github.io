---
interface Props {
  src: string;
  alt?: string;
  size?: "xs" | "sm" | "md" | "lg" | "xl";
}

const { src, alt = "", size = "xl" } = Astro.props;

const sizeMap: Record<string, string> = {
  xs: "320px",
  sm: "480px",
  md: "640px",
  lg: "800px",
  xl: "100%",
};
---

<div
  class={`content-image content-image--${size}`}
  style={`max-width: ${sizeMap[size]}`}
>
  <img
    src={src}
    alt={alt}
    class="content-image__img"
    loading="lazy"
    decoding="async"
  />
</div>

<style>
  .content-image {
    margin: 2rem auto;
    overflow: hidden;
    border-radius: 0.375rem;
    background: var(--color-bg-secondary);
  }

  .content-image__img {
    display: block;
    width: 100%;
    object-fit: contain;
  }

  @media (max-width: 719px) {
    .content-image {
      margin-block: 1.5rem;
    }
  }
</style>
