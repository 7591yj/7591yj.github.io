---
import "./TableOfContents.css";
import { useTranslations } from "../../../i18n/ui";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const minDepth = Math.min(...headings.map((h) => h.depth));
const sections = headings.filter((h) => h.depth === minDepth).length;
---

<nav class="toc" aria-label={t("writing.contents")}>
  <p class="toc__head">
    <span>{t("writing.contents")}</span>
    <span>{String(sections).padStart(2, "0")}</span>
  </p>
  <ul class="toc__list">
    {
      headings.map((h) => (
        <li
          class:list={["toc__item", { "toc__item--sub": h.depth > minDepth }]}
          style={`--indent: ${h.depth - minDepth}`}
        >
          <a class="toc__link" href={`#${h.slug}`} data-slug={h.slug}>
            {h.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import { initToc } from "./tableOfContentsScript";
  initToc();
  document.addEventListener("astro:page-load", initToc);
</script>
