---
import MetaTags from "./MetaTags.astro";

interface Props {
  isNew?: boolean;
  date: string;
  tags?: string[];
}

const { isNew, date, tags } = Astro.props;
const hasTags = !!(tags && tags.length > 0);
---

<div class="blog-entry__meta">
  {isNew && <span class="blog-entry__led" />}
  <span class="blog-entry__date">{date}</span>
  {hasTags && <MetaTags tags={tags!} />}
</div>

<style>
  .blog-entry__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .blog-entry__led {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background-color: var(--color-accent);
    box-shadow: 0 0 6px var(--color-accent);
    flex-shrink: 0;
  }

  .blog-entry__date {
    font-family: monospace;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }
</style>
