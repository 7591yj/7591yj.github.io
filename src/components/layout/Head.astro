---
import { Font } from "astro:assets";
import { AUTHOR } from "../../consts";
import SocialMeta from "./SocialMeta.astro";

interface Props {
  title: string;
  metaDescription: string;
  canonicalUrl: string;
  type: string;
  ogImage: string;
  jsonLd: object;
  robotsContent?: string;
}

const {
  title,
  metaDescription,
  canonicalUrl,
  type,
  ogImage,
  jsonLd,
  robotsContent,
} = Astro.props;
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <Font
    cssVariable="--font-archivo"
    preload={[{ weight: "400", style: "normal", subset: "latin" }]}
  />
  <Font cssVariable="--font-noto-sans-jp" />
  <Font cssVariable="--font-plex-mono" />
  <Font cssVariable="--font-plex-sans-jp" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>

  <meta name="description" content={metaDescription} />
  <meta name="author" content={AUTHOR} />
  <link rel="canonical" href={canonicalUrl} />

  <SocialMeta
    type={type}
    canonicalUrl={canonicalUrl}
    title={title}
    metaDescription={metaDescription}
    ogImage={ogImage}
  />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  {robotsContent && <meta name="robots" content={robotsContent} />}

  <script is:inline>
    (function () {
      const KEY = "nav-dot";
      function pill() {
        const dot = document.querySelector(".shell-nav__dot");
        const nav = dot && dot.closest(".shell-nav");
        return (
          dot && {
            dot: dot.getBoundingClientRect(),
            nav: nav.getBoundingClientRect(),
          }
        );
      }
      addEventListener("pageswap", function (event) {
        try {
          const p = event.viewTransition && pill();
          if (p) {
            sessionStorage.setItem(
              KEY,
              JSON.stringify({ x: p.dot.left - p.nav.left, w: p.dot.width }),
            );
          } else {
            sessionStorage.removeItem(KEY);
          }
        } catch {
          return;
        }
      });
      let revealed;
      window.pageReveal = new Promise(function (resolve) {
        revealed = resolve;
      });
      if (!("onpagereveal" in window)) revealed(null);
      addEventListener("pagereveal", function (event) {
        revealed(event.viewTransition);
        let from;
        try {
          from = JSON.parse(sessionStorage.getItem(KEY));
          sessionStorage.removeItem(KEY);
        } catch {
          return;
        }
        const vt = event.viewTransition;
        if (!vt || !from) return;
        vt.ready.then(function () {
          const p = pill();
          const group = "::view-transition-group(shell-nav-dot)";
          if (!p) {
            // shell.css paints this group even without an active tab.
            document.documentElement.animate(
              { opacity: [0, 0] },
              { duration: 1e5, pseudoElement: group },
            );
            return;
          }
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          const y = p.dot.top;
          const ease = getComputedStyle(document.documentElement)
            .getPropertyValue("--ease-out-expo")
            .trim();
          // shell.css pins the transform origin while this stretches the pill.
          const scale = from.w / p.dot.width;
          document.documentElement.animate(
            {
              transform: [
                "translate(" +
                  (p.nav.left + from.x) +
                  "px, " +
                  y +
                  "px) scaleX(" +
                  scale +
                  ")",
                "translate(" + p.dot.left + "px, " + y + "px) scaleX(1)",
              ],
            },
            {
              duration: 520,
              easing: ease || "cubic-bezier(0.16, 1, 0.3, 1)",
              fill: "both",
              pseudoElement: group,
            },
          );
        });
      });
    })();
  </script>
  <script is:inline>
    (function () {
      function resolveTheme() {
        const stored = localStorage.getItem("theme");
        const systemDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        return stored === "system" || !stored
          ? systemDark
            ? "dark"
            : "light"
          : stored;
      }
      document.documentElement.setAttribute("data-theme", resolveTheme());
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("js-motion");
      }
      document.addEventListener("astro:after-swap", function () {
        document.documentElement.setAttribute("data-theme", resolveTheme());
      });
      try {
        const arrive = sessionStorage.getItem("arrive");
        if (arrive) {
          sessionStorage.removeItem("arrive");
          document.documentElement.classList.add("arrive-dive");
          if (arrive === "exact") {
            // field.ts has already placed the plate and text.
            window.addEventListener("pagereveal", function (event) {
              if (event.viewTransition) event.viewTransition.skipTransition();
            });
          }
        }
      } catch {
        return;
      }
    })();
  </script>
</head>
