---
import { Icon } from "astro-icon/components";

interface Props {
  label?: string;
}

const { label = "Toggle theme" } = Astro.props;
---

<button id="theme-toggle" aria-label={label} class="theme-toggle">
  <Icon class="icon-sun" name="carbon:light" />
  <Icon class="icon-moon" name="carbon:moon" />
</button>

<style>
  .theme-toggle {
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 999px;
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--color-text-primary);
  }
  .theme-toggle :global(svg) {
    transition: scale 320ms var(--ease-out-expo);
  }
  .theme-toggle:active :global(svg) {
    scale: 0.82;
  }

  :global([data-theme="light"]) .icon-moon {
    display: none;
  }
  :global([data-theme="dark"]) .icon-sun {
    display: none;
  }
</style>

<script>
  import "./ThemeToggle.client.ts";
</script>
