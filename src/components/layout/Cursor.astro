---
import "./cursor.css";

interface Props {
  openLabel: string;
}

const { openLabel } = Astro.props;
---

<div
  class="shell-cursor"
  data-shell-cursor
  data-state="hidden"
  data-open-label={openLabel}
  aria-hidden="true"
>
  <span class="shell-cursor__cross"></span>
  <span class="shell-cursor__label" data-shell-cursor-label hidden></span>
</div>
