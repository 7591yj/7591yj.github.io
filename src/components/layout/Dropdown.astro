---
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  languages: { code: string; label: string }[];
  currentLocale: string;
  pathWithoutLocale: string;
}

const { languages, currentLocale, pathWithoutLocale } = Astro.props;
---

<div id="lang-dropdown" class="lang-dropdown" role="menu">
  {
    languages.map(({ code, label }) => {
      const href = getRelativeLocaleUrl(code, pathWithoutLocale);
      return (
        <a
          href={href}
          class:list={["lang-option", { active: code === currentLocale }]}
          role="menuitem"
        >
          {label}
        </a>
      );
    })
  }
</div>
