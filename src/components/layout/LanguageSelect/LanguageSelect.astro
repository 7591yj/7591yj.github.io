---
import { Icon } from "astro-icon/components";
import Dropdown from "../Dropdown.astro";
import "./LanguageSelect.css";

const languages = [
  { code: "en", label: "English" },
  { code: "ja", label: "日本語" },
  // { code: "ko", label: "한국어" },
];

const currentLocale = Astro.currentLocale || "en";

const localeCodes = languages.map((l) => l.code);
const segments = Astro.url.pathname.split("/").filter(Boolean);
const pathWithoutLocale =
  segments.length > 0 && localeCodes.includes(segments[0])
    ? "/" + segments.slice(1).join("/")
    : Astro.url.pathname;
---

<div class="lang-select">
  <button id="lang-toggle" class="nav-link" aria-label="Change language">
    <span id="lang-label">{currentLocale.toUpperCase()}</span>
    <span class="lang-icon">
      <Icon name="carbon:triangle-down-solid" />
    </span>
  </button>
  <Dropdown
    languages={languages}
    currentLocale={currentLocale}
    pathWithoutLocale={pathWithoutLocale}
  />
</div>

<script>
  import { initLangSelect } from "./langSelectScript";
  initLangSelect();
</script>
