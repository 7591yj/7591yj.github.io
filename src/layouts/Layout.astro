---
import { Font } from "astro:assets";
import Header from "../components/layout/Header/Header.astro";
import Footer from "../components/layout/Footer/Footer.astro";
import Head from "../components/layout/Head.astro";
import { SITE_NAME, SITE_DESCRIPTION, SITE_OG_IMAGE, AUTHOR } from "../consts";
import "../styles/global.css";
import "../styles/layout.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishDate?: string;
  noindex?: boolean;
  transparentHeader?: boolean;
}

const {
  title = SITE_NAME,
  description,
  image,
  type = "website",
  publishDate,
  noindex = false,
  transparentHeader = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image ?? SITE_OG_IMAGE, Astro.site).href;
const metaDescription = description ?? SITE_DESCRIPTION;
const robotsMetaContent = noindex ? "noindex" : undefined;

const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description: metaDescription,
        url: canonicalUrl,
        datePublished: publishDate,
        author: { "@type": "Person", name: AUTHOR },
        image: ogImage,
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        url: Astro.site,
        name: SITE_NAME,
        description: SITE_DESCRIPTION,
      };
---

<Font cssVariable="--font-shippori" preload />
<html lang={Astro.currentLocale ?? "en"}>
  <Head
    title={title}
    metaDescription={metaDescription}
    canonicalUrl={canonicalUrl}
    type={type}
    ogImage={ogImage}
    jsonLd={jsonLd}
    robotsContent={robotsMetaContent}
  />
  <body>
    <Header transparentHeader={transparentHeader} />
    <slot />
    <Footer />
    <script>
      import "../scripts/layout-init.client.ts";
    </script>
  </body>
</html>
