---
import DetailLayout, { type MetaItem } from "./DetailLayout.astro";
import { SITE_NAME } from "../consts";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../i18n/ui";
import { render } from "astro:content";
import { statusLabel, yearLabel } from "../lib/projects";
import { projectLinkLabel } from "../lib/projectLinks";
import { getProjects, type ProjectEntry } from "../lib/content";
import { locales } from "../i18n/ui";
import { mdxComponents } from "../components/content/mdxComponents";

interface Props {
  entry: ProjectEntry;
}

const { entry } = Astro.props;
const {
  title,
  subtitle,
  year,
  status,
  link,
  links = [],
  current,
  tech,
  thumbnail,
  images,
} = entry.data;
const { locale, slug } = entry;
const { Content, headings } = await render(entry.source);
const t = useTranslations(locale);
const alternates = Object.fromEntries(
  await Promise.all(
    locales
      .filter((other) => other !== locale)
      .map(async (other) => {
        const translation = (await getProjects(other)).find(
          (project) => project.slug === slug,
        );
        return [other, translation?.url ?? getRelativeLocaleUrl(other, "/")];
      }),
  ),
);

const tools = tech.filter((name) => name[0] !== name[0].toLowerCase());
const projectLinks = [
  ...(link ? [{ label: projectLinkLabel(link), href: link }] : []),
  ...links.map(({ label, href }) => ({
    label: projectLinkLabel(href, label),
    href,
  })),
];
const years = yearLabel({ year, current });
const meta: MetaItem[] = [
  { label: t("meta.year"), value: years },
  { label: t("meta.status"), value: statusLabel(t, status) },
  ...(projectLinks.length > 0
    ? [
        {
          label: t(projectLinks.length > 1 ? "meta.links" : "meta.link"),
          links: projectLinks,
        },
      ]
    : []),
];
---

<DetailLayout
  title={`${SITE_NAME} | ${title}`}
  description={subtitle}
  section="work"
  kicker={[t(current ? "work.nowBuilding" : "work.project"), years]}
  headingTitle={title}
  subtitle={subtitle}
  image={thumbnail ?? images?.[0]}
  meta={meta}
  tags={tools}
  tagsLabel={t("meta.stack")}
  alternates={alternates}
  backLinkHref={getRelativeLocaleUrl(locale, "/")}
  backLinkLabel={t("shell.backWork")}
  headings={headings}
>
  <Content components={mdxComponents} />
</DetailLayout>
