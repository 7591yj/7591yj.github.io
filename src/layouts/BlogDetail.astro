---
import { formatDate } from "../lib/date";
import { readingMinutes } from "../lib/reading";
import DetailLayout, { type MetaItem } from "./DetailLayout.astro";
import { SITE_NAME } from "../consts";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../i18n/ui";
import { render } from "astro:content";
import { getBlogPosts, type BlogPostEntry } from "../lib/content";
import { locales } from "../i18n/ui";
import { mdxComponents } from "../components/content/mdxComponents";

interface Props {
  entry: BlogPostEntry;
}

const { entry } = Astro.props;
const { title, date, description, tags } = entry.data;
const { locale, slug } = entry;
const { Content, headings } = await render(entry.source);
const t = useTranslations(locale);
const otherLocale = locales.find((l) => l !== locale)!;
const translation = (await getBlogPosts(otherLocale)).find(
  (other) => other.slug === slug,
);
const alternate =
  translation?.url ?? getRelativeLocaleUrl(otherLocale, "/blog");

const meta: MetaItem[] = [
  { label: t("meta.date"), value: formatDate(date) },
  {
    label: t("meta.readTime"),
    value: t("writing.minutes", { count: String(readingMinutes(entry)) }),
  },
];
---

<DetailLayout
  title={`${SITE_NAME} | ${title}`}
  description={description}
  type="article"
  publishDate={date}
  section="writing"
  kicker={[t("shell.writing"), formatDate(date)]}
  headingTitle={title}
  subtitle={description}
  meta={meta}
  tags={tags}
  tagsLabel={t("meta.tags")}
  alternate={alternate}
  backLinkHref={getRelativeLocaleUrl(locale, "/blog")}
  backLinkLabel={t("shell.backWriting")}
  headings={headings}
>
  <Content components={mdxComponents} />
</DetailLayout>
