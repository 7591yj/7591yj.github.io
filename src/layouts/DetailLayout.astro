---
import Shell, { type Alternates, type ShellSection } from "./Shell.astro";
import TableOfContents from "../components/content/TableOfContents/TableOfContents.astro";
import "../components/entry/entry.css";

export interface MetaItem {
  label: string;
  value: string;
  href?: string;
}

interface Props {
  title: string;
  section: ShellSection;
  kicker: string[];
  headingTitle: string;
  subtitle?: string;
  image?: string;
  meta: MetaItem[];
  tags?: string[];
  tagsLabel: string;
  alternates: Alternates;
  backLinkHref: string;
  backLinkLabel: string;
  headings: { depth: number; slug: string; text: string }[];
  description?: string;
  type?: "website" | "article";
  publishDate?: string;
}

const {
  title,
  section,
  kicker,
  headingTitle,
  subtitle,
  image,
  meta,
  tags = [],
  tagsLabel,
  alternates,
  backLinkHref,
  backLinkLabel,
  headings,
  description,
  type,
  publishDate,
} = Astro.props;
---

<Shell
  active={section}
  alternates={alternates}
  title={title}
  description={description}
  type={type}
  publishDate={publishDate}
>
  <div class="read-progress" aria-hidden="true"></div>
  <main class="entry">
    <header class:list={["entry-hero", { "entry-hero--text": !image }]}>
      <div class="entry-hero__text">
        <p class="kicker" data-reveal>
          {kicker.map((part) => <span>{part}</span>)}
        </p>
        <h1 class="display entry-title">{headingTitle}</h1>
        {
          subtitle && (
            <p class="entry-sub" data-reveal>
              {subtitle}
            </p>
          )
        }
        <dl class="entry-meta" data-reveal>
          {
            meta.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>
                  {item.href ? (
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {item.value} ↗
                    </a>
                  ) : (
                    item.value
                  )}
                </dd>
              </div>
            ))
          }
          {
            tags.length > 0 && (
              <div class="entry-meta__tags">
                <dt>{tagsLabel}</dt>
                <dd>
                  {tags.map((tag) => (
                    <span class="chip">{tag}</span>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>
      </div>
      {
        image && (
          <div class="entry-plate">
            <img src={image} alt="" />
          </div>
        )
      }
    </header>

    <section class="entry-body" data-reveal>
      {
        headings.length > 0 && (
          <aside class="entry-toc">
            <TableOfContents headings={headings} />
          </aside>
        )
      }
      <article class="prose">
        <slot />
      </article>
    </section>

    <footer class="entry-foot">
      <a href={backLinkHref}>← {backLinkLabel}</a>
    </footer>
  </main>
</Shell>

<script>
  import "../scripts/detail.client.ts";
</script>
