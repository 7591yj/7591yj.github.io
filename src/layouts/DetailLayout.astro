---
import Layout from "./Layout.astro";
import PageHeading from "../components/ui/PageHeading.astro";
import TableOfContents from "../components/content/TableOfContents/TableOfContents.astro";
import ProjectSlogan from "../components/content/ProjectSlogan.astro";
import "../styles/detail.css";

interface Props {
  title: string;
  module: string;
  headingTitle: string;
  backLinkHref: string;
  backLinkLabel: string;
  headings: { depth: number; slug: string; text: string }[];
  subtitle?: string;
  description?: string;
  type?: "website" | "article";
  publishDate?: string;
}

const {
  title,
  module,
  headingTitle,
  backLinkHref,
  backLinkLabel,
  headings,
  subtitle,
  description,
  type,
  publishDate,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  type={type}
  publishDate={publishDate}
>
  <main>
    <section class="header">
      <PageHeading module={module} title={headingTitle}>
        <slot name="meta" />
      </PageHeading>
      {subtitle && <ProjectSlogan text={subtitle} />}
    </section>
    <section class="container-main detail">
      <div class="detail__main">
        <article class="prose">
          <slot />
        </article>

        <a class="back-link" href={backLinkHref}>&larr; {backLinkLabel}</a>
      </div>

      {
        headings.length > 0 && (
          <aside class="detail__sidebar">
            <TableOfContents headings={headings} />
          </aside>
        )
      }
    </section>
  </main>
</Layout>

<script>
  import "../scripts/detail.client.ts";
</script>
